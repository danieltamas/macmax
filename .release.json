{
  "branch": "main",
  "log": "LOG.md",
  "architecture": "docs/ARCHITECTURE.md",
  "test": [
    "scripts/check.sh"
  ],
  "build": [
    "scripts/release.sh {version} --verify"
  ],
  "assets": [
    "dist/MacMax-{version}.zip",
    "dist/SHA256SUMS"
  ],
  "githubRelease": true,
  "verify": [
    "MACMAX_VERSION={version} bash install.sh",
    "test \"$(defaults read /Applications/MacMax.app/Contents/Info.plist CFBundleShortVersionString)\" = {version}"
  ]
}
